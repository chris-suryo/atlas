# Supabase — copy to `.env.local` and fill in from your project's
# Project Settings → API. The anon/publishable key is safe for the browser
# (Row-Level Security enforces per-user access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Playwright (npm run test:e2e) — copy to `.env.test.local`. Dedicated,
# RLS-isolated test account in the same Supabase project; never Chris's own
# credentials. Never commit this file — it holds a real password.
E2E_TEST_EMAIL=YOUR-TEST-ACCOUNT-EMAIL
E2E_TEST_PASSWORD=YOUR-TEST-ACCOUNT-PASSWORD
